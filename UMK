CC = gcc
PKG_CONFIG = pkg-config
PKG_MODULES = wayland-server wlroots-0.20 xkbcommon libinput libdrm gbm pixman-1 gdk-pixbuf-2.0 egl glesv2
CFLAGS = -Isrc -O3 -Wall -Wextra -Werror -march=native -flto=auto -DWLR_USE_UNSTABLE $(shell $(PKG_CONFIG) --cflags $(PKG_MODULES))
PKG_LIBS = $(shell $(PKG_CONFIG) --libs $(PKG_MODULES) | tr ' ' '\n' | grep -vx -e -ldl | tr '\n' ' ')
DL_LIBS = $(shell uname -s | grep -qv -e NetBSD -e FreeBSD -e OpenBSD -e DragonFly -e Darwin && printf -- '-ldl' || :)
LDFLAGS = $(PKG_LIBS) -lm $(DL_LIBS)
SRCS = $(wildcard src/*.c)
OBJS = $(SRCS:.c=.o)
src/%.o: src/%.c
	$(CC) $(CFLAGS) -c -o $@ $<
eoc
tools/%.o: tools/%.c
	$(CC) $(CFLAGS) -c -o $@ $<
eoc
wyowm: $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
eoc
wyoctl: tools/wyoctl.o
	$(CC) $(CFLAGS) -o $@ $^
eoc
build:
	call wyowm
	call wyoctl
eoc
update:
	call clean
	call build
	call install
eoc
install:
	sudo install -Dm755 wyowm /usr/bin/wyowm
	sudo install -Dm755 wyoctl /usr/bin/wyoctl
	sudo install -Dm755 wyowm-session /usr/bin/wyowm-session
	sudo install -Dm755 wyowm-session-nested /usr/bin/wyowm-session-nested
	sudo install -Dm755 wyoconf-reload /usr/bin/wyoconf-reload
	test -d /usr/share/wayland-sessions && sudo install -Dm644 wyowm.desktop /usr/share/wayland-sessions/wyowm.desktop || true
	test -d /usr/pkg/share/wayland-sessions && sudo install -Dm644 wyowm.desktop /usr/pkg/share/wayland-sessions/wyowm.desktop || true
	test -d /usr/local/share/wayland-sessions && sudo install -Dm644 wyowm.desktop /usr/local/share/wayland-sessions/wyowm.desktop || true
eoc
uninstall:
	sudo rm -f /usr/bin/wyowm
	sudo rm -f /usr/bin/wyoctl
	sudo rm -f /usr/bin/wyowm-session
	sudo rm -f /usr/bin/wyowm-session-nested
	sudo rm -f /usr/bin/wyoconf-reload
	sudo rm -f /usr/share/wayland-sessions/wyowm.desktop
	sudo rm -f /usr/pkg/share/wayland-sessions/wyowm.desktop
	sudo rm -f /usr/local/share/wayland-sessions/wyowm.desktop
eoc
clean:
	rm -f src/*.o src/*.d tools/*.o tools/*.d wyowm wyoctl
eoc
