#!/bin/sh
rm -f /tmp/wyowm.log /tmp/wyowm-spawn.log

if [ -z "$XDG_RUNTIME_DIR" ]; then
	XDG_RUNTIME_DIR="/run/user/$(id -u)"
	export XDG_RUNTIME_DIR
	mkdir -p "$XDG_RUNTIME_DIR"
	chmod 700 "$XDG_RUNTIME_DIR"
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=wyoWM
export XDG_SESSION_DESKTOP=wyoWM
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND=wayland
export GTK_CSD=0
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_SIZE=24
export XCURSOR_THEME=Adwaita
export XCURSOR_PATH="$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons:/usr/share/pixmaps"

unset WAYLAND_DISPLAY
unset DISPLAY

if [ -n "$XDG_RUNTIME_DIR" ]; then
	rm -f "$XDG_RUNTIME_DIR/wayland-0" "$XDG_RUNTIME_DIR/wayland-0.lock"
	rm -f "$XDG_RUNTIME_DIR/wayland-1" "$XDG_RUNTIME_DIR/wayland-1.lock"
	rm -f /tmp/.X11-unix/X0
	rm -f /tmp/.X11-unix/X1
fi

export WLR_BACKEND=drm
exec dbus-run-session /usr/local/bin/wyowm >/tmp/wyowm.log 2>&1
